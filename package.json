{
  "name": "tend",
  "version": "1.1.14",
  "description": "A calm, personal environment that helps people plan their days, focus, take notes, build routines, reflect, and reduce distractions.",
  "author": "Tend Team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && npm run verify:assets",
    "electron:start": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:build": "npm run build && electron-builder",
    "build:desktop": "npm run electron:build",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "backend:check": "supabase db lint && supabase test db",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:auth": "playwright test tests/auth",
    "test:database": "vitest run tests/database --passWithNoTests",
    "test:security": "vitest run supabase/functions scripts/verify-security.test.mjs --passWithNoTests",
    "test:sync": "vitest run src/sync tests/sync --passWithNoTests",
    "test:unit": "vitest run src",
    "typecheck": "tsc -b",
    "verify:assets": "node scripts/verify-assets.mjs dist/index.html dist",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "3.23.2",
    "@clerk/testing": "2.2.45",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "6.2.5",
    "supabase": "2.120.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
