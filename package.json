{
  "name": "tend",
  "version": "1.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && npm run verify:assets",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "typecheck": "tsc -b",
    "verify:assets": "node scripts/verify-assets.mjs dist/index.html dist",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
