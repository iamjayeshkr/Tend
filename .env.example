# Browser-visible configuration. Only publishable keys belong in VITE_* values.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk Frontend API hostname only (for example, discreet-cat-12.clerk.accounts.dev).
VITE_CLERK_FRONTEND_API_HOST=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Edge-only configuration. Never expose these values to browser bundles.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
TEND_CLERK_AUDIENCE=tend-sync
TEND_CLERK_ISSUER=
TEND_CLERK_AUTHORIZED_PARTIES=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,tend://renderer
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TEND_RATE_LIMIT_KEY_SECRET=
TEND_CURSOR_SECRET=
TEND_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,tend://renderer
TEND_SCHEDULER_SECRET=

# Credential-backed integration tests. Leave blank to run only the fail-closed
# public-route tests; signed-in workspace tests require these values.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
CLERK_TEST_PUBLISHABLE_KEY=
CLERK_TEST_SECRET_KEY=
CLERK_TESTING_TOKEN=
E2E_CLERK_USER_A_EMAIL=
E2E_CLERK_USER_A_PASSWORD=
E2E_CLERK_USER_B_EMAIL=
E2E_CLERK_USER_B_PASSWORD=
